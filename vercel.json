{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "installCommand": "npm install --include=dev"
    },
    "pos": {
      "root": "apps/pos",
      "framework": "vite",
      "installCommand": "npm install --include=dev"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "pos" }
    }
  ]
}
