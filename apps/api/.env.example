# Copia este archivo como .env y ajusta los valores.
# El servidor lee las variables del entorno del sistema; este archivo es de referencia.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Si defines DATABASE_URL, se usa PostgreSQL real.
# DATABASE_URL=postgres://usuario:contrasena@localhost:5432/mostrador

# Sin DATABASE_URL se usa PGlite. Con esta carpeta persiste en disco; sin ella, en memoria.
PGLITE_DIR=./.data/pglite

# Obligatorio en produccion (minimo 16 caracteres).
JWT_SECRET=cambia-esta-cadena-por-una-larga-y-secreta
JWT_EXPIRA=12h

# Panel del desarrollador en /actualizaciones. No es la contrasena del
# administrador del negocio: es la clave del programador de la app.
# Si no se define, el panel responde que no esta configurado.
DEVELOPER_TOKEN=
# Opcional: si la instalacion tiene una sola empresa, se usa la primera.
DEVELOPER_COMPANY_ID=

# Fotos de productos en Supabase Storage. La secret key es secreta:
# solo vive en el servidor, nunca en el navegador.
# SUPABASE_URL=https://tuproyecto.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Compatibilidad con proyectos antiguos: SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=productos
