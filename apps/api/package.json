{
  "name": "@mostrador/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "API de la nube: catalogo, inventario, ventas, contabilidad y sincronizacion",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.4",
    "@mostrador/db-cloud": "^0.0.1",
    "@mostrador/domain": "^0.0.1",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
