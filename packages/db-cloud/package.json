{
  "name": "@mostrador/db-cloud",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Modelo de datos (PostgreSQL) y cliente de base de datos para la nube de Mostrador",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  }
}
